<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: exclude all app data from cloud backup and device-to-device
  transfer. Secure storage values are encrypted with a Keystore key that is
  never transferred, so restored copies could not be decrypted, and health
  data should not leave the device this way.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
